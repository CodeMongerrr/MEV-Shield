# URL of the MEV Shield agent API. Read at build time, so rebuild after changing it.
# Local Node server http://localhost:3001, local Worker (wrangler dev) http://localhost:8787,
# deployed Worker https://mev-shield-api.<your-subdomain>.workers.dev
VITE_API_URL=http://localhost:3001

# WalletConnect project ID from https://cloud.reown.com (public client ID, restrict it to your domains in the Reown dashboard).
# Optional. Without it the dashboard still works read only and browser extension wallets can connect.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional RPC for the dashboard's wagmi client (defaults to a public endpoint)
VITE_MAINNET_RPC_URL=

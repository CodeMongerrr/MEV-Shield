# Required. Ethereum mainnet JSON-RPC endpoint (Alchemy, Infura, QuickNode or any provider).
# The historical pool scan reads reserves at past blocks, so an archive-capable endpoint is best.
RPC_URL=

# Optional for POST /swap, required for /pool-threat. Create one at https://thegraph.com/studio/
GRAPH_API_KEY=

# Optional. Enable L2 gas pricing and LI.FI bridge quotes in the route check.
ARBITRUM_RPC_URL=
BASE_RPC_URL=

# Optional. HTTP port for the API (default 3001).
PORT=3001

# Cloudflare Worker only (wrangler dev reads this file too). Defaults live in worker.ts.
# ALLOWED_ORIGIN=*
# RATE_LIMIT_PER_MINUTE=30
# DEBUG_LOGS=1

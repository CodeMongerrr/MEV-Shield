{
  "name": "agent",
  "version": "1.0.0",
  "description": "MEV Shield agent. Simulates sandwich attacks on live Uniswap V2 reserves and searches for the cheapest execution plan.",
  "main": "index.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "worker:dev": "npx wrangler dev",
    "worker:check": "npx wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "npx wrangler deploy"
  },
  "keywords": [],
  "author": "Aditya Joshi",
  "license": "MIT",
  "packageManager": "pnpm@9.11.0+sha512.0a203ffaed5a3f63242cd064c8fb5892366c103e328079318f78062f24ea8c9d50bc6a47aa3567cabefd824d170e78fa2745ed1f16b132e16436146b7688f19b",
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "viem": "^2.45.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.0"
  }
}
